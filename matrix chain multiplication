#include <iostream>
#include <climits>
using namespace std;

int main()
{
    int p[] = {10, 20, 30, 40, 30};
    int n = 4;

    int m[5][5];

    for (int i = 1; i <= n; i++)
        m[i][i] = 0;

    for (int L = 2; L <= n; L++)
    {
        for (int i = 1; i <= n - L + 1; i++)
        {
            int j = i + L - 1;
            m[i][j] = INT_MAX;

            for (int k = i; k < j; k++)
            {
                int cost = m[i][k] +
                           m[k + 1][j] +
                           p[i - 1] * p[k] * p[j];

                if (cost < m[i][j])
                    m[i][j] = cost;
            }
        }
    }

    cout << "Minimum number of multiplications: " << m[1][n] << endl;

    return 0;
}
